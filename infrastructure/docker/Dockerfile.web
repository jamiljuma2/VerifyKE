# syntax=docker/dockerfile:1.7
# VerifyKE web image (Next.js, standalone output).
#
# Build (from the repository root):
#   docker build -f infrastructure/docker/Dockerfile.web -t verifyke-web .

# ---------------------------------------------------------------- deps
FROM node:22-alpine AS deps
WORKDIR /build
COPY package.json package-lock.json* ./ 
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --workspace @verifyke/web --include-workspace-root || npm install --workspace @verifyke/web --include-workspace-root

# ---------------------------------------------------------------- build
FROM node:22-alpine AS builder
WORKDIR /build
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /build/node_modules ./node_modules
COPY --from=deps /build/apps/web/node_modules ./apps/web/node_modules
COPY package.json ./package.json
COPY apps/web ./apps/web
# NEXT_PUBLIC_* values are inlined at build time, so they must be build args.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ARG NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_PUBLIC_WEB_BASE_URL=${NEXT_PUBLIC_WEB_BASE_URL}
RUN npm run build --workspace @verifyke/web

# ---------------------------------------------------------------- runtime
FROM node:22-alpine AS runtime
ARG GIT_SHA=unknown
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    VERIFYKE_GIT_SHA=${GIT_SHA}

RUN addgroup --system --gid 10001 nodejs \
    && adduser --system --uid 10001 --ingroup nodejs nextjs \
    && apk add --no-cache curl

WORKDIR /app

# `output: "standalone"` in next.config.ts produces this self-contained bundle.
COPY --from=builder --chown=nextjs:nodejs /build/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /build/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /build/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:3000/api/healthz || exit 1

CMD ["node", "apps/web/server.js"]
