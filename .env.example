# =============================================================================
# VerifyKE environment configuration - DEVELOPMENT TEMPLATE
# =============================================================================
# Copy this file to `.env` and adjust. NEVER commit the real `.env`.
#   cp .env.example .env
#
# Every value below is read by the API, worker, web app and Docker Compose.
# Secrets shown here are development placeholders only; production deployments
# must generate fresh values (see README -> "Generating secrets").
# =============================================================================

# ------------------------------------------------------------------ application
VK_APP_ENV=development            # development | test | production
VK_APP_NAME=VerifyKE
VK_DEBUG=false
VK_WEB_BASE_URL=http://localhost:3000
VK_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------ security
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
VK_SECRET_KEY=dev-only-insecure-secret-change-me-0123456789abcdef
VK_JWT_ALGORITHM=HS256
VK_ACCESS_TOKEN_TTL_MINUTES=10
VK_REFRESH_TOKEN_TTL_DAYS=14
VK_REAUTH_WINDOW_MINUTES=5
VK_PASSWORD_MIN_LENGTH=12
VK_PASSWORD_MIN_ZXCVBN_SCORE=3
VK_COOKIE_SECURE=false            # MUST be true in production (https only)
VK_COOKIE_SAMESITE=strict
# Roles that must enrol MFA before using the platform
VK_MFA_REQUIRED_ROLES=SUPER_ADMIN,INSTITUTION_ADMIN

# ------------------------------------------------------------------ database
VK_DATABASE_URL=postgresql+psycopg://verifyke:verifyke@localhost:5432/verifyke
VK_DB_POOL_SIZE=10
VK_DB_MAX_OVERFLOW=20
VK_DB_ECHO=false
VK_DB_STATEMENT_TIMEOUT_MS=15000

# ------------------------------------------------------------------ cache / queue
VK_REDIS_URL=redis://localhost:6379/0
VK_CELERY_BROKER_URL=redis://localhost:6379/1
VK_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------ object storage
# s3 (MinIO locally, S3 in the cloud) or local (filesystem fallback)
VK_STORAGE_BACKEND=s3
VK_S3_ENDPOINT_URL=http://localhost:9000
VK_S3_REGION=us-east-1
VK_S3_ACCESS_KEY=verifyke-minio
VK_S3_SECRET_KEY=verifyke-minio-secret
VK_S3_BUCKET_CERTIFICATES=verifyke-certificates
VK_S3_BUCKET_UPLOADS=verifyke-uploads
VK_S3_BUCKET_INSTITUTION_DOCS=verifyke-institution-docs
VK_SIGNED_URL_TTL_SECONDS=300
# Local filesystem storage (used when VK_STORAGE_BACKEND=local)
# VK_LOCAL_STORAGE_PATH=/home/jamil/VerifyKE/.runtime/storage

# ------------------------------------------------------------------ uploads / malware scanning
VK_UPLOAD_MAX_BYTES=10485760
VK_UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg
VK_UPLOAD_PDF_MAX_PAGES=20
VK_UPLOAD_IMAGE_MAX_PIXELS=40000000
# none (development) | clamav (recommended in production)
VK_MALWARE_SCANNER=none
VK_CLAMAV_HOST=localhost
VK_CLAMAV_PORT=3310

# ------------------------------------------------------------------ OCR / document analysis
VK_OCR_ENABLED=true
VK_OCR_MIN_CONFIDENCE=0.70
VK_TESSERACT_CMD=tesseract
VK_OCR_LANGUAGES=eng
VK_DOCUMENT_ANALYSIS_ENABLED=true

# ------------------------------------------------------------------ mail
# console (prints to logs) | smtp (Mailpit locally, SES/Sendgrid in production)
VK_MAIL_BACKEND=console
VK_SMTP_HOST=localhost
VK_SMTP_PORT=1025
VK_SMTP_USE_TLS=false
VK_MAIL_FROM=no-reply@verifyke.local
VK_MAIL_FROM_NAME=VerifyKE

# ------------------------------------------------------------------ key management
# local (master key from env) | aws_kms (production)
VK_KEY_PROVIDER=local
# Generate with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
VK_MASTER_KEY=
VK_AWS_KMS_REGION=eu-west-1
VK_AWS_KMS_KEY_ID=

# ------------------------------------------------------------------ rate limiting
VK_RATE_LIMIT_ENABLED=true
VK_RATE_LIMIT_LOGIN=10/5m
VK_RATE_LIMIT_PASSWORD_RESET=5/15m
VK_RATE_LIMIT_REGISTER=10/1h
VK_RATE_LIMIT_VERIFY_PUBLIC=60/1m
VK_RATE_LIMIT_VERIFY_UPLOAD=20/5m
VK_RATE_LIMIT_EXTERNAL_API=600/1m
VK_RATE_LIMIT_DEFAULT=300/1m

# ------------------------------------------------------------------ billing
# sandbox (development) | payhero (Kenya)
VK_PAYMENT_PROVIDER=sandbox
VK_PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
VK_PAYHERO_AUTH_TOKEN=
VK_PAYHERO_CHANNEL_ID=
VK_PAYHERO_WEBHOOK_SECRET=
VK_BILLING_CURRENCY=KES

# ------------------------------------------------------------------ observability
VK_LOG_LEVEL=INFO
VK_LOG_JSON=false
VK_METRICS_ENABLED=true
# Optional: requires "pip install sentry-sdk"
VK_SENTRY_DSN=

# ------------------------------------------------------------------ http
VK_CORS_ORIGINS=http://localhost:3000
VK_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ------------------------------------------------------------------ privacy / retention
VK_PRIVACY_RETENTION_DAYS_UPLOADS=30
VK_PRIVACY_RETENTION_DAYS_AUDIT_LOGS=2557
VK_PUBLIC_VERIFICATION_MASKS_NAMES=true

# =============================================================================
# Docker Compose only (not read by the application)
# =============================================================================
POSTGRES_USER=verifyke
POSTGRES_PASSWORD=verifyke
POSTGRES_DB=verifyke
POSTGRES_PORT=5432
MINIO_ROOT_USER=verifyke-minio
MINIO_ROOT_PASSWORD=verifyke-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000
NGINX_HTTP_PORT=8080
MAILPIT_UI_PORT=8025
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
