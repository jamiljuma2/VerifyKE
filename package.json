{
  "name": "verifyke",
  "version": "0.1.0",
  "private": true,
  "description": "VerifyKE - Trust Every Credential. Verify Every Certificate.",
  "workspaces": [
    "apps/web",
    "packages/ui",
    "packages/shared-types"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev --workspace @verifyke/web",
    "build": "npm run build --workspace @verifyke/web",
    "start": "npm run start --workspace @verifyke/web",
    "lint": "npm run lint --workspace @verifyke/web && npm run lint --workspace @verifyke/shared-types",
    "typecheck": "npm run typecheck --workspace @verifyke/shared-types && npm run typecheck --workspace @verifyke/web",
    "test": "npm run test --workspace @verifyke/web --if-present",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,json,md}\" \"packages/**/*.{ts,tsx,json,md}\"",
    "api:dev": ".venv/bin/uvicorn verifyke.main:app --reload --app-dir apps/api --host 0.0.0.0 --port 8000",
    "api:test": ".venv/bin/pytest -c apps/api/pyproject.toml apps/api/tests",
    "api:lint": ".venv/bin/ruff check apps/api",
    "api:migrate": ".venv/bin/alembic -c apps/api/alembic.ini upgrade head"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
